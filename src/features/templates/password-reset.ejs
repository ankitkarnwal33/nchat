<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Password Reset Email</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: Inter, Arial, sans-serif;
      color: #282828;
    "
  >
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="margin: 0; padding: 32px 8px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            cellpadding="0"
            cellspacing="0"
            border="0"
            width="100%"
            style="
              max-width: 620px;
              background-color: #ffffff;
              border: 1px solid #eceaf0;
              border-radius: 18px;
              overflow: hidden;
              box-shadow: 0 14px 40px rgba(15, 23, 42, 0.1);
            "
          >
            <tr>
              <td style="padding: 0">
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  width="100%"
                  style="background: #ff9722"
                >
                  <tr>
                    <td style="padding: 36px 40px 28px 40px; text-align: left">
                      <div
                        style="
                          display: inline-block;
                          padding: 8px 14px;
                          border-radius: 999px;
                          background-color: rgba(255, 255, 255, 0.18);
                          color: #1f1a12;
                          font-size: 12px;
                          line-height: 12px;
                          letter-spacing: 0.08em;
                          font-weight: 700;
                          text-transform: uppercase;
                        "
                      >
                        Account Security
                      </div>
                      <h1
                        style="
                          margin: 18px 0 10px 0;
                          font-size: 32px;
                          line-height: 38px;
                          color: #1a1a1a;
                          font-weight: 800;
                        "
                      >
                        Reset your password
                      </h1>
                      <p
                        style="
                          margin: 0;
                          max-width: 430px;
                          font-size: 16px;
                          line-height: 26px;
                          color: #3f3120;
                        "
                      >
                        We received a request to reset the password for your
                        account. Use the button below to choose a new password
                        securely.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 40px">
                <p
                  style="
                    margin: 0 0 16px 0;
                    font-size: 16px;
                    line-height: 28px;
                    color: #444444;
                  "
                >
                  Hi <%= user_name %>,
                </p>

                <p
                  style="
                    margin: 0 0 24px 0;
                    font-size: 15px;
                    line-height: 26px;
                    color: #5d6470;
                  "
                >
                  If you requested this password reset, click the button below.
                  This link is designed to keep your account safe and should
                  only be used by you.
                </p>

                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin: 0 0 24px 0"
                >
                  <tr>
                    <td
                      align="center"
                      bgcolor="#f3c763"
                      style="border-radius: 12px"
                    >
                      <a
                        href="<%= reset_password_url %>"
                        style="
                          display: inline-block;
                          padding: 16px 28px;
                          font-size: 15px;
                          font-weight: 700;
                          line-height: 15px;
                          color: #171717;
                          text-decoration: none;
                          border-radius: 12px;
                          background: #ff9722;
                        "
                      >
                        Reset Password
                      </a>
                    </td>
                  </tr>
                </table>

                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  width="100%"
                  style="margin: 0 0 24px 0"
                >
                  <tr>
                    <td
                      style="
                        padding: 18px 20px;
                        border: 1px solid #eceaf0;
                        border-radius: 14px;
                        background-color: #fbfaf7;
                      "
                    >
                      <p
                        style="
                          margin: 0 0 8px 0;
                          font-size: 13px;
                          line-height: 20px;
                          font-weight: 700;
                          color: #3d4451;
                          text-transform: uppercase;
                          letter-spacing: 0.05em;
                        "
                      >
                        Security note
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-size: 14px;
                          line-height: 24px;
                          color: #6b7280;
                        "
                      >
                        This reset link will expire in
                        <strong>30 minutes</strong>. If you did not request a
                        password reset, you can safely ignore this email and
                        your password will remain unchanged.
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0 0 10px 0;
                    font-size: 14px;
                    line-height: 24px;
                    color: #5d6470;
                  "
                >
                  Button not working? Copy and paste this URL into your browser:
                </p>
                <p
                  style="
                    margin: 0 0 28px 0;
                    word-break: break-all;
                    font-size: 13px;
                    line-height: 22px;
                    color: #b06416;
                  "
                >
                  <a
                    href="<%= reset_password_url %>"
                    style="color: #b06416; text-decoration: none"
                    ><%= reset_password_url %></a
                  >
                </p>

                <div
                  style="
                    height: 1px;
                    background-color: #eceaf0;
                    margin: 0 0 28px 0;
                  "
                ></div>

                <p
                  style="
                    margin: 0 0 16px 0;
                    font-size: 14px;
                    line-height: 24px;
                    color: #5d6470;
                  "
                >
                  Stay connected with us:
                </p>

                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin: 0 0 28px 0"
                >
                  <tr>
                    <td style="padding-right: 10px">
                      <a
                        href="https://facebook.com"
                        style="
                          display: inline-block;
                          padding: 10px 16px;
                          border-radius: 999px;
                          background-color: #f4f4f5;
                          color: #1f2937;
                          font-size: 13px;
                          font-weight: 700;
                          text-decoration: none;
                        "
                      >
                        Facebook
                      </a>
                    </td>
                    <td style="padding-right: 10px">
                      <a
                        href="https://instagram.com"
                        style="
                          display: inline-block;
                          padding: 10px 16px;
                          border-radius: 999px;
                          background-color: #fff4e8;
                          color: #b06416;
                          font-size: 13px;
                          font-weight: 700;
                          text-decoration: none;
                        "
                      >
                        Instagram
                      </a>
                    </td>
                    <td>
                      <a
                        href="https://youtube.com"
                        style="
                          display: inline-block;
                          padding: 10px 16px;
                          border-radius: 999px;
                          background-color: #fff1f2;
                          color: #c81e1e;
                          font-size: 13px;
                          font-weight: 700;
                          text-decoration: none;
                        "
                      >
                        YouTube
                      </a>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0;
                    font-size: 14px;
                    line-height: 24px;
                    color: #5d6470;
                  "
                >
                  This is an auto-generated email. Please do not reply to this
                  email.
                </p>
              </td>
            </tr>

            <tr>
              <td
                style="
                  padding: 24px 40px 34px 40px;
                  background-color: #faf8f4;
                  border-top: 1px solid #eceaf0;
                "
              >
                <p
                  style="
                    margin: 0 0 8px 0;
                    font-size: 14px;
                    line-height: 22px;
                    color: #2d2d2d;
                    font-weight: 700;
                  "
                >
                  N-Chat
                </p>
                <p
                  style="
                    margin: 0;
                    font-size: 12px;
                    line-height: 20px;
                    color: #7c8593;
                  "
                >
                  This email was sent regarding the security of your account.
                  Please do not share your reset link with anyone.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
